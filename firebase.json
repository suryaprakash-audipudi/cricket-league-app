{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "rewrites": [
      {
        "source": "/api/players/**",
        "function": "api"
      },
      {
        "source": "/api/teams/**",
        "function": "api"
      },
      {
        "source": "/api/leagues",
        "function": "leagueService"
      },
      {
        "source": "/api/leagues/**",
        "function": "leagueService"
      },
      {
        "source": "/api",
        "function": "api"
      },
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
  
  "emulators": {
    "functions": {
      "port": 5005
    },
    "ui": {
      "enabled": true
    }
  }
}