rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. SPONSORS_ADS COLLECTION RULES
    match /sponsors_ads/{adId} {
      allow read, write: if request.resource.data.sponsorName is string
                         && request.resource.data.mediaUrl is string
                         && request.resource.data.mediaType in ['IMAGE', 'VIDEO', 'INTERACTIVE']
                         && request.resource.data.placement in ['HOME_BANNER', 'SCORE_BOTTOM', 'LIVE_STREAM_OVERLAY']
                         && request.resource.data.sponsorLevel in ['LEAGUE', 'APP', 'TEAM', 'PLAYER']
                         && request.resource.data.geoScope.level in ['DISTRICT', 'STATE', 'NATIONAL', 'INTERNATIONAL']
                         && request.resource.data.geoScope.country is string
                         && request.resource.data.isActive is bool;
    }

    // 2. USERS (PLAYERS/ADMINS) COLLECTION RULES
    match /users/{userId} {
      allow read, write: if request.resource.data.name is string
                         && request.resource.data.phone is string
                         && request.resource.data.role in ['PLAYER', 'TEAM_OWNER', 'ADMIN', 'SCORER']
                         && request.resource.data.geoScope.level in ['DISTRICT', 'STATE', 'NATIONAL', 'INTERNATIONAL']
                         && request.resource.data.geoScope.country is string;
    }

    // 3. TEAMS COLLECTION RULES
    match /teams/{teamId} {
      allow read, write: if request.resource.data.teamName is string
                         && request.resource.data.logoUrl is string
                         && request.resource.data.ownerId is string
                         && request.resource.data.geoScope.level in ['DISTRICT', 'STATE', 'NATIONAL', 'INTERNATIONAL']
                         && request.resource.data.playerIds is list;
    }
  }
}
